example/common/tiny_shakespeare_dataset.o: example/common/tiny_shakespeare_dataset.cc.o
.PHONY : example/common/tiny_shakespeare_dataset.o

# target to build an object file
example/common/tiny_shakespeare_dataset.cc.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/gpt2.dir/build.make CMakeFiles/gpt2.dir/example/common/tiny_shakespeare_dataset.cc.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/mixtral.dir/build.make CMakeFiles/mixtral.dir/example/common/tiny_shakespeare_dataset.cc.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/llama3.dir/build.make CMakeFiles/llama3.dir/example/common/tiny_shakespeare_dataset.cc.o
.PHONY : example/common/tiny_shakespeare_dataset.cc.o

example/common/tiny_shakespeare_dataset.i: example/common/tiny_shakespeare_dataset.cc.i
.PHONY : example/common/tiny_shakespeare_dataset.i

# target to preprocess a source file
example/common/tiny_shakespeare_dataset.cc.i:
