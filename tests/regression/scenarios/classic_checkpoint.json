{
  "schema_version": 1,
  "id": "classic_checkpoint",
  "models": [
    "gpt2",
    "llama3"
  ],
  "profile": "classic",
  "tags": [
    "classic",
    "checkpoint"
  ],
  "suites": [
    "nightly",
    "release"
  ],
  "nproc_per_node": 1,
  "checks": [
    {
      "kind": "finite_and_complete"
    }
  ],
  "templates": [
    {
      "args": {"num_iteration": 50, "save_interval": 10, "save": "@CKPT_ROOT_DIR@/no_resume"},
      "variants": [{"id": "ckpt_no_resume", "args": {}}]
    },
    {
      "args": {"num_iteration": 50, "save_interval": 10, "load": "@CKPT_ROOT_DIR@/no_resume/checkpoint_step_000030", "save": "@CKPT_ROOT_DIR@/base_resume"},
      "variants": [{"id": "ckpt_resume", "args": {}}]
    },
    {
      "args": {"num_iteration": 50, "save_interval": 10, "save": "@CKPT_ROOT_DIR@/bfloat16_no_resume"},
      "variants": [{"id": "ckpt_bfloat16", "args": {"dtype": "bfloat16"}}]
    },
    {
      "args": {"num_iteration": 50, "save_interval": 10, "load": "@CKPT_ROOT_DIR@/bfloat16_no_resume/checkpoint_step_000030", "save": "@CKPT_ROOT_DIR@/bfloat16_resume"},
      "variants": [{"id": "ckpt_bfloat16_resume", "args": {"dtype": "bfloat16"}}]
    },
    {
      "args": {"nthread_per_process": 8, "num_iteration": 50, "save_interval": 10, "batch_size": 40, "total_batch_size": 5120, "tensor_parallel": 2, "sequence_parallel": true, "pipeline_parallel": 2, "virtual_pipeline_parallel": 2, "save": "@CKPT_ROOT_DIR@/3d_ddp2_tp2_pp2_no_resume", "max_checkpoint_keep": 5},
      "variants": [{"id": "ckpt_3d_ddp_tp_pp", "args": {}}]
    },
    {
      "args": {"nthread_per_process": 8, "num_iteration": 50, "save_interval": 10, "batch_size": 40, "total_batch_size": 5120, "tensor_parallel": 2, "sequence_parallel": true, "pipeline_parallel": 2, "virtual_pipeline_parallel": 2, "load": "@CKPT_ROOT_DIR@/3d_ddp2_tp2_pp2_no_resume/checkpoint_step_000030", "save": "@CKPT_ROOT_DIR@/3d_tp2_pp2_resume", "max_checkpoint_keep": 5},
      "variants": [{"id": "ckpt_3d_ddp_tp_pp_resume", "args": {}}]
    }
  ]
}
