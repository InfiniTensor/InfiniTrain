{
  "schema_version": 1,
  "id": "tiny_scheduler",
  "models": [
    "gpt2",
    "llama3",
    "qwen3"
  ],
  "profile": "tiny",
  "tags": [
    "tiny",
    "lr_scheduler",
    "anchor"
  ],
  "suites": [
    "pr",
    "nightly",
    "release"
  ],
  "matrix": {
    "lr_decay_style": [
      "none",
      "constant",
      "linear",
      "cosine",
      "inverse-square-root"
    ]
  },
  "args": {
    "num_iteration": 6,
    "learning_rate": 0.0001,
    "min_lr": 1e-05,
    "lr_warmup_iters": 2,
    "lr_decay_iters": 6
  },
  "batch": {
    "micro_batch_samples": 2,
    "sequence_length": 16,
    "accumulation_steps": 1
  },
  "checks": [
    {
      "kind": "finite_and_complete"
    },
    {
      "kind": "lr_schedule"
    }
  ]
}
